// Prisma Schema Specification for Banyubiru Administrative Intelligence Platform
// Phase 4G Canonical Schema Reconciliation - Authoritative Tenant-Aware Model

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------
// ENUM DEFINITIONS
// ----------------------------------------------------

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserRole {
  ADMIN_TENANT
  ADMIN
  OPERATOR
  VERIFIKATOR
  AUDITOR
  PEGAWAI
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum EmployeeStatus {
  PNS
  PPPK
  HONORER
  NON_ASN
}

enum DocumentCategory {
  KARTU_KELUARGA
  KTP
  AKTA_KELAHIRAN
  IJAZAH
  RAPOR
  SERTIFIKAT
  SURAT_PERNYATAAN
  SURAT_PERMOHONAN
  SURAT_TUGAS
  SURAT_KEPUTUSAN
  LAINNYA
}

enum DocumentStatus {
  DRAFT
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  ARCHIVED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  NEEDS_CORRECTION
}

enum VerificationDecision {
  PASSED
  FLAGGED
  REJECTED
}

enum StudentStatus {
  ACTIVE
  GRADUATED
  TRANSFERRED
}


enum OCRExtractionStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum DocumentProcessingStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum StudentAbsenceWorkflowState {
  DRAFT
  NEEDS_VERIFICATION
  REQUIRES_CORRECTION
  VERIFIED
  COMPLETED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ExceptionStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum PublicUploadInvitationStatus {
  PENDING
  REVOKED
  EXPIRED
  SUBMITTED
}

// ----------------------------------------------------
// MODEL DEFINITIONS
// ----------------------------------------------------

model Tenant {
  id        String       @id @db.Uuid
  name      String       @db.VarChar(255)
  code      String       @unique @db.VarChar(64)
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  users                   UserActor[]
  employees               Employee[]
  students                Student[]
  documents               Document[]
  ocrExtractions          OCRExtraction[]
  humanVerifications      HumanVerification[]
  workflowInstances       WorkflowInstance[]
  validationResults       ValidationResult[]
  exceptionItems          ExceptionItem[]
  auditEvents             AuditEvent[]
  extractedItems          ExtractedItem[]
  documentVersions        DocumentVersion[]
  workflowTransitions     WorkflowTransition[]
  publicUploadInvitations PublicUploadInvitation[]
  documentProcessingJobs  DocumentProcessingJob[]

  @@map("tenants")
}

model UserActor {
  id        String     @id @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  username  String     @db.VarChar(128)
  email     String     @db.VarChar(255)
  fullName  String     @map("full_name") @db.VarChar(255)
  role         UserRole
  passwordHash String?    @map("password_hash") @db.VarChar(255)
  status       UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant                    Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  humanVerifications        HumanVerification[]
  lockedWorkflowInstances   WorkflowInstance[]
  workflowTransitions       WorkflowTransition[]
  assignedExceptions        ExceptionItem[]          @relation("AssignedExceptions")
  resolvedExceptions        ExceptionItem[]          @relation("ResolvedExceptions")
  auditEvents               AuditEvent[]
  createdPublicInvitations  PublicUploadInvitation[] @relation("CreatedPublicInvitations")
  documentProcessingJobs    DocumentProcessingJob[]

  @@unique([tenantId, id])
  @@unique([tenantId, username])
  @@unique([tenantId, email])
  @@index([tenantId, role])
  @@map("user_actors")
}

model Employee {
  id                String         @id @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  nip               String         @db.VarChar(18)
  nrk               String?        @db.VarChar(10)
  fullName          String         @map("nama_lengkap") @db.VarChar(255)
  gelarDepan        String?        @map("gelar_depan") @db.VarChar(50)
  gelarBelakang     String?        @map("gelar_belakang") @db.VarChar(50)
  jabatan           String         @db.VarChar(255)
  unitKerja         String         @map("unit_kerja") @db.VarChar(255)
  instansi          String         @map("instansi") @db.VarChar(255)
  statusKepegawaian EmployeeStatus @map("status_kepegawaian")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, nip])
  @@unique([tenantId, nrk])
  @@index([tenantId, unitKerja])
  @@map("employees")
}

model Student {
  id        String        @id @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  nisn      String        @db.VarChar(10)
  nis       String        @db.VarChar(20)
  fullName  String        @map("nama_lengkap") @db.VarChar(255)
  className String        @map("kelas") @db.VarChar(50)
  status    StudentStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, nisn])
  @@unique([tenantId, nis])
  @@index([tenantId, className])
  @@map("students")
}


model OCRExtraction {
  id           String              @id @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  documentId   String              @map("document_id") @db.Uuid
  status       OCRExtractionStatus @default(QUEUED)
  rawJson      Json?               @map("raw_json")
  errorMessage String?             @map("error_message") @db.Text
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  document Document        @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  items    ExtractedItem[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("ocr_extractions")
}

model ExtractedItem {
  id              String             @id @db.Uuid
  tenantId        String             @map("tenant_id") @db.Uuid
  ocrExtractionId String             @map("ocr_extraction_id") @db.Uuid
  fieldKey        String             @map("field_key") @db.VarChar(100)
  fieldName       String?            @map("field_name") @db.VarChar(100)
  value           String             @map("value") @db.Text
  rawValue        String?            @map("raw_value") @db.Text
  normalizedValue String?            @map("normalized_value") @db.Text
  confidenceScore Decimal            @default(0) @map("confidence_score") @db.Decimal(5, 2)
  pageNumber      Int?               @map("page_number")
  boundingBox     Json?              @map("bounding_box")
  status          VerificationStatus @default(PENDING) @map("status")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ocrExtraction OCRExtraction @relation(fields: [tenantId, ocrExtractionId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, ocrExtractionId])
  @@index([tenantId, fieldKey])
  @@map("extracted_items")
}

model Document {
  id             String           @id @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  title          String           @db.VarChar(255)
  category       DocumentCategory
  currentVersion Int              @default(1) @map("current_version")
  status         DocumentStatus   @default(DRAFT)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  versions                DocumentVersion[]
  ocrExtractions          OCRExtraction[]
  publicUploadInvitations PublicUploadInvitation[]
  processingJobs          DocumentProcessingJob[]

  @@unique([tenantId, id])
  @@index([tenantId, category])
  @@map("documents")
}

model DocumentVersion {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  documentId     String   @map("document_id") @db.Uuid
  versionNumber  Int      @map("version_number")
  filePath       String   @map("file_path") @db.VarChar(500)
  fileSizeBytes  BigInt   @map("file_size_bytes")
  mimeType       String   @map("mime_type") @db.VarChar(100)
  checksumSha256 String?  @map("checksum_sha256") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant         Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  document       Document                @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)
  processingJobs DocumentProcessingJob[]

  @@unique([tenantId, id])
  @@unique([documentId, versionNumber])
  @@map("document_versions")
}

model HumanVerification {
  id               String               @id @db.Uuid
  tenantId         String               @map("tenant_id") @db.Uuid
  targetEntityType String               @map("target_entity_type") @db.VarChar(50)
  targetEntityId   String               @map("target_entity_id") @db.Uuid
  verifiedByUserId String               @map("verified_by_user_id") @db.Uuid
  decision         VerificationDecision @map("decision")
  notes            String?              @db.Text
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  verifiedByUser UserActor @relation(fields: [tenantId, verifiedByUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, targetEntityType, targetEntityId])
  @@map("human_verifications")
}

model WorkflowInstance {
  id             String               @id @db.Uuid
  tenantId       String               @map("tenant_id") @db.Uuid
  entityType     String               @map("entity_type") @db.VarChar(50)
  entityId       String               @map("entity_id") @db.Uuid
  currentState   String               @map("current_state") @db.VarChar(50)
  lockedByUserId String?              @map("locked_by_user_id") @db.Uuid
  lockedUntil    DateTime?            @map("locked_until") @db.Timestamptz
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lockedByUser   UserActor?           @relation(fields: [tenantId, lockedByUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  transitions    WorkflowTransition[]
  exceptionItems ExceptionItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, entityType, entityId])
  @@index([tenantId, currentState])
  @@map("workflow_instances")
}

model WorkflowTransition {
  id                 String           @id @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  workflowInstanceId String           @map("workflow_instance_id") @db.Uuid
  fromState          String           @map("from_state") @db.VarChar(50)
  toState            String           @map("to_state") @db.VarChar(50)
  triggeredByUserId  String           @map("triggered_by_user_id") @db.Uuid
  reason             String?          @db.Text
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  workflowInstance WorkflowInstance @relation(fields: [tenantId, workflowInstanceId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)
  triggeredByUser  UserActor        @relation(fields: [tenantId, triggeredByUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@map("workflow_transitions")
}

model ValidationResult {
  id               String   @id @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  ruleCode         String   @map("rule_code") @db.VarChar(100)
  targetEntityType String   @map("target_entity_type") @db.VarChar(50)
  targetEntityId   String   @map("target_entity_id") @db.Uuid
  passed           Boolean  @map("passed")
  detailsJson      Json?    @map("details_json")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, targetEntityType, targetEntityId])
  @@map("validation_results")
}

model ExceptionItem {
  id                 String          @id @db.Uuid
  tenantId           String          @map("tenant_id") @db.Uuid
  workflowInstanceId String          @map("workflow_instance_id") @db.Uuid
  ruleCode           String          @map("rule_code") @db.VarChar(100)
  severity           Severity
  status             ExceptionStatus @default(OPEN)
  assignedToUserId   String?         @map("assigned_to_user_id") @db.Uuid
  resolutionNotes    String?         @map("resolution_notes") @db.Text
  resolvedByUserId   String?         @map("resolved_by_user_id") @db.Uuid
  resolvedAt         DateTime?       @map("resolved_at") @db.Timestamptz
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  workflowInstance WorkflowInstance @relation(fields: [tenantId, workflowInstanceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  assignedToUser   UserActor?       @relation("AssignedExceptions", fields: [tenantId, assignedToUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  resolvedByUser   UserActor?       @relation("ResolvedExceptions", fields: [tenantId, resolvedByUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, severity])
  @@map("exception_items")
}

model AuditEvent {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(50)
  entityId    String   @map("entity_id") @db.Uuid
  payloadJson Json?    @map("payload_json")
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actorUser UserActor? @relation(fields: [tenantId, actorUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
  @@map("audit_events")
}

model PublicUploadInvitation {
  id                 String                       @id @db.Uuid
  tenantId           String                       @map("tenant_id") @db.Uuid
  tokenHash          String                       @unique @map("token_hash") @db.VarChar(64)
  recipientEmail     String                       @map("recipient_email") @db.VarChar(255)
  recipientName      String?                      @map("recipient_name") @db.VarChar(255)
  documentCategory   DocumentCategory             @map("document_category")
  targetEntityType   String                       @map("target_entity_type") @db.VarChar(50)
  targetEntityId     String                       @map("target_entity_id") @db.Uuid
  status             PublicUploadInvitationStatus @default(PENDING)
  documentId         String?                      @map("document_id") @db.Uuid
  createdByUserId    String                       @map("created_by_user_id") @db.Uuid
  expiresAt          DateTime                     @map("expires_at") @db.Timestamptz
  consumedAt         DateTime?                    @map("consumed_at") @db.Timestamptz
  maxUploadAttempts  Int                          @default(3) @map("max_upload_attempts")
  uploadAttempts     Int                          @default(0) @map("upload_attempts")
  createdAt          DateTime                     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdByUser UserActor  @relation("CreatedPublicInvitations", fields: [tenantId, createdByUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  document      Document?  @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, targetEntityType, targetEntityId])
  @@index([tokenHash])
  @@map("public_upload_invitations")
}

model DocumentProcessingJob {
  id                String                   @id @db.Uuid
  tenantId          String                   @map("tenant_id") @db.Uuid
  documentId        String                   @map("document_id") @db.Uuid
  documentVersionId String                   @map("document_version_id") @db.Uuid
  actorId           String                   @map("actor_id") @db.Uuid
  targetDomain      String                   @map("target_domain") @db.VarChar(50)
  metadata          Json?                    @map("metadata")
  status            DocumentProcessingStatus @default(QUEUED)
  attempts          Int                      @default(0) @map("attempts")
  maxAttempts       Int                      @default(3) @map("max_attempts")
  lastError         String?                  @map("last_error") @db.Text
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  processedAt       DateTime?                @map("processed_at") @db.Timestamptz

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  document        Document        @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  documentVersion DocumentVersion @relation(fields: [tenantId, documentVersionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  actor           UserActor       @relation(fields: [tenantId, actorId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, documentVersionId])
  @@index([tenantId, status])
  @@index([status, createdAt])
  @@map("document_processing_jobs")
}
