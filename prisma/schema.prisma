// Prisma Schema Specification for Banyubiru Administrative Intelligence Platform
// Phase 4G Canonical Schema Reconciliation - Authoritative Tenant-Aware Model

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------
// ENUM DEFINITIONS
// ----------------------------------------------------

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserRole {
  ADMIN_TENANT
  ADMIN
  OPERATOR
  VERIFIKATOR
  AUDITOR
  PEGAWAI
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum EmployeeStatus {
  PNS
  PPPK
  HONORER
  NON_ASN
}

enum DocumentCategory {
  KARTU_KELUARGA
  KTP
  AKTA_KELAHIRAN
  IJAZAH
  RAPOR
  SERTIFIKAT
  SURAT_PERNYATAAN
  SURAT_PERMOHONAN
  SURAT_TUGAS
  SURAT_KEPUTUSAN
  LAINNYA
}

enum DocumentStatus {
  DRAFT
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  ARCHIVED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  NEEDS_CORRECTION
}

enum VerificationDecision {
  PASSED
  FLAGGED
  REJECTED
}

enum StudentStatus {
  ACTIVE
  GRADUATED
  TRANSFERRED
}

enum OCRExtractionStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum DocumentProcessingStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum ExtractionStatus {
  BERHASIL
  PERLU_DIPERIKSA
  GAGAL
}

enum MatchingStatus {
  COCOK
  PERLU_DIPERIKSA
  TIDAK_DITEMUKAN
}

enum StudentAbsenceWorkflowState {
  DRAFT
  NEEDS_VERIFICATION
  REQUIRES_CORRECTION
  VERIFIED
  COMPLETED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ExceptionStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum PublicUploadInvitationStatus {
  PENDING
  REVOKED
  EXPIRED
  SUBMITTED
}

// ----------------------------------------------------
// MODEL DEFINITIONS
// ----------------------------------------------------

model Tenant {
  id               String       @id @db.Uuid
  name             String       @db.VarChar(255)
  code             String       @unique @db.VarChar(64)
  npsn             String?      @db.VarChar(10)
  address          String?      @map("alamat") @db.Text
  phone            String?      @map("telepon") @db.VarChar(50)
  email            String?      @db.VarChar(255)
  logoPath         String?      @map("logo_path") @db.VarChar(512)
  letterheadConfig Json?        @map("kop_surat")
  signers          Json?        @map("penandatangan")
  status           TenantStatus @default(ACTIVE)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  users                   UserActor[]
  employees               Employee[]
  students                Student[]
  documents               Document[]
  documentVersions        DocumentVersion[]
  ocrExtractions          OCRExtraction[]
  extractedItems          ExtractedItem[]
  extractionResults       ExtractionResult[]
  matchingResults         MatchingResult[]
  matchingCandidates      MatchingCandidate[]
  humanVerifications      HumanVerification[]
  workflowInstances       WorkflowInstance[]
  workflowTransitions     WorkflowTransition[]
  validationResults       ValidationResult[]
  exceptionItems          ExceptionItem[]
  auditEvents             AuditEvent[]
  publicUploadInvitations PublicUploadInvitation[]
  documentProcessingJobs  DocumentProcessingJob[]
  letterTemplates         LetterTemplate[]

  @@map("tenants")
}

model UserActor {
  id           String     @id @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  username     String     @db.VarChar(128)
  email        String     @db.VarChar(255)
  fullName     String     @map("full_name") @db.VarChar(255)
  role         UserRole
  passwordHash String?    @map("password_hash") @db.VarChar(255)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant                   Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  humanVerifications       HumanVerification[]
  lockedWorkflowInstances  WorkflowInstance[]
  workflowTransitions      WorkflowTransition[]
  assignedExceptions       ExceptionItem[]          @relation("AssignedExceptions")
  resolvedExceptions       ExceptionItem[]          @relation("ResolvedExceptions")
  auditEvents              AuditEvent[]
  createdPublicInvitations PublicUploadInvitation[] @relation("CreatedPublicInvitations")
  documentProcessingJobs   DocumentProcessingJob[]
  confirmedMatchingResults MatchingResult[]         @relation("ConfirmedByUser")

  @@unique([tenantId, id])
  @@unique([tenantId, username])
  @@unique([tenantId, email])
  @@index([tenantId, role])
  @@map("user_actors")
}

model Employee {
  id                String         @id @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  nip               String?        @db.VarChar(18)
  nrk               String?        @db.VarChar(10)
  nik               String?        @db.VarChar(16)
  fullName          String         @map("nama_lengkap") @db.VarChar(255)
  gelarDepan        String?        @map("gelar_depan") @db.VarChar(50)
  gelarBelakang     String?        @map("gelar_belakang") @db.VarChar(50)
  jabatan           String         @db.VarChar(255)
  unitKerja         String         @map("unit_kerja") @db.VarChar(255)
  instansi          String         @map("instansi") @db.VarChar(255)
  statusKepegawaian EmployeeStatus @map("status_kepegawaian")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, nip])
  @@unique([tenantId, nrk])
  @@unique([tenantId, nik])
  @@index([tenantId, unitKerja])
  @@map("employees")
}

model Student {
  id        String        @id @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  nisn      String        @db.VarChar(10)
  nis       String        @db.VarChar(20)
  fullName  String        @map("nama_lengkap") @db.VarChar(255)
  className String        @map("kelas") @db.VarChar(50)
  status    StudentStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, nisn])
  @@unique([tenantId, nis])
  @@index([tenantId, className])
  @@map("students")
}

model LetterTemplate {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  code       String   @map("kode_template") @db.VarChar(50)
  name       String   @map("nama_template") @db.VarChar(255)
  letterType String   @map("jenis_surat") @db.VarChar(100)
  content    String   @map("isi_template") @db.Text
  variables  Json     @map("variabel")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, letterType])
  @@index([tenantId, isActive])
  @@map("letter_templates")
}

model Document {
  id              String           @id @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  title           String           @db.VarChar(255)
  category        DocumentCategory
  source          String           @default("UNGGAH_LANGSUNG") @map("sumber") @db.VarChar(50)
  currentVersion  Int              @default(1) @map("current_version")
  status          DocumentStatus   @default(DRAFT)
  retentionUntil  DateTime?        @map("retention_until") @db.Timestamptz
  archivedAt      DateTime?        @map("archived_at") @db.Timestamptz
  archiveLocation String?          @map("archive_location") @db.VarChar(500)
  isTemporary     Boolean          @default(false) @map("is_temporary")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  versions                DocumentVersion[]
  ocrExtractions          OCRExtraction[]
  extractionResults       ExtractionResult[]
  matchingResults         MatchingResult[]
  publicUploadInvitations PublicUploadInvitation[]
  processingJobs          DocumentProcessingJob[]

  @@unique([tenantId, id])
  @@index([tenantId, category])
  @@index([tenantId, source])
  @@index([tenantId, status])
  @@map("documents")
}

model DocumentVersion {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  documentId     String   @map("document_id") @db.Uuid
  versionNumber  Int      @map("version_number")
  filePath       String   @map("file_path") @db.VarChar(500)
  storageKey     String?  @map("storage_key") @db.VarChar(500)
  storageStatus  String   @default("ACTIVE") @map("storage_status") @db.VarChar(50)
  fileSizeBytes  BigInt   @map("file_size_bytes")
  mimeType       String   @map("mime_type") @db.VarChar(100)
  checksumSha256 String?  @map("checksum_sha256") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  document          Document                @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)
  processingJobs    DocumentProcessingJob[]
  ocrExtractions    OCRExtraction[]
  extractionResults ExtractionResult[]
  matchingResults   MatchingResult[]

  @@unique([tenantId, id])
  @@unique([documentId, versionNumber])
  @@map("document_versions")
}

model OCRExtraction {
  id                String              @id @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  documentId        String              @map("document_id") @db.Uuid
  documentVersionId String?             @map("document_version_id") @db.Uuid
  status            OCRExtractionStatus @default(QUEUED)
  extractedText     String?             @map("extracted_text") @db.Text
  rawJson           Json?               @map("raw_json")
  errorMessage      String?             @map("error_message") @db.Text
  startedAt         DateTime?           @map("started_at") @db.Timestamptz
  completedAt       DateTime?           @map("completed_at") @db.Timestamptz
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  document          Document         @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  documentVersion   DocumentVersion? @relation(fields: [tenantId, documentVersionId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)
  items             ExtractedItem[]
  extractionResults ExtractionResult[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, documentVersionId])
  @@map("ocr_extractions")
}

model ExtractedItem {
  id              String             @id @db.Uuid
  tenantId        String             @map("tenant_id") @db.Uuid
  ocrExtractionId String             @map("ocr_extraction_id") @db.Uuid
  fieldKey        String             @map("field_key") @db.VarChar(100)
  fieldName       String?            @map("field_name") @db.VarChar(100)
  value           String             @map("value") @db.Text
  rawValue        String?            @map("raw_value") @db.Text
  normalizedValue String?            @map("normalized_value") @db.Text
  confidenceScore Decimal            @default(0) @map("confidence_score") @db.Decimal(5, 2)
  pageNumber      Int?               @map("page_number")
  boundingBox     Json?              @map("bounding_box")
  status          VerificationStatus @default(PENDING) @map("status")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ocrExtraction OCRExtraction @relation(fields: [tenantId, ocrExtractionId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, ocrExtractionId])
  @@index([tenantId, fieldKey])
  @@map("extracted_items")
}

// P0-I: Extraction result -- canonical fields dari OCR yang siap dicocokkan
model ExtractionResult {
  id                String           @id @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  documentId        String           @map("document_id") @db.Uuid
  documentVersionId String           @map("document_version_id") @db.Uuid
  ocrExtractionId   String           @map("ocr_extraction_id") @db.Uuid
  field             String           @db.VarChar(100)
  value             String?          @db.Text
  source            String?          @db.VarChar(255)
  confidenceScore   Decimal?         @db.Decimal(5, 2)
  status            ExtractionStatus @default(BERHASIL)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  document        Document        @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  documentVersion DocumentVersion @relation(fields: [tenantId, documentVersionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  ocrExtraction   OCRExtraction   @relation(fields: [tenantId, ocrExtractionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  matchingResults MatchingResult[]

  // Idempotency: one field per OCR extraction
  @@unique([tenantId, id])
  @@unique([tenantId, ocrExtractionId, field])
  @@index([tenantId, documentId])
  @@index([tenantId, documentVersionId])
  @@index([tenantId, field])
  @@index([tenantId, status])
  @@map("extraction_results")
}

// P0-J: Matching result -- satu proses pencocokan per extraction+entityType
// Kandidat disimpan terpisah di MatchingCandidate
model MatchingResult {
  id                   String         @id @db.Uuid
  tenantId             String         @map("tenant_id") @db.Uuid
  documentId           String         @map("document_id") @db.Uuid
  documentVersionId    String         @map("document_version_id") @db.Uuid
  extractionResultId   String         @map("extraction_result_id") @db.Uuid
  // "STUDENT" atau "EMPLOYEE" (Guru & Karyawan)
  entityType           String         @db.VarChar(50)
  // Nilai asli dari field ekstraksi yang dicocokkan
  extractedValue       String         @db.Text
  // Status pencocokan otomatis
  status               MatchingStatus @default(PERLU_DIPERIKSA)
  confidenceScore      Decimal?       @db.Decimal(5, 2)
  matchingReason       String?        @db.Text
  // Konfirmasi manual oleh Administrator/Operator
  manuallyConfirmed    Boolean        @default(false) @map("manually_confirmed")
  // FK ke MatchingCandidate yang dipilih saat konfirmasi manual
  confirmedCandidateId String?        @map("confirmed_candidate_id") @db.Uuid
  confirmedByUserId    String?        @map("confirmed_by_user_id") @db.Uuid
  confirmedAt          DateTime?      @map("confirmed_at") @db.Timestamptz
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  document           Document            @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  documentVersion    DocumentVersion     @relation(fields: [tenantId, documentVersionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  extractionResult   ExtractionResult    @relation(fields: [tenantId, extractionResultId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  candidates         MatchingCandidate[] @relation("ResultCandidates")
  // Kandidat yang dikonfirmasi manual
  confirmedCandidate MatchingCandidate?  @relation("ConfirmedCandidate", fields: [tenantId, confirmedCandidateId], references: [tenantId, id])
  confirmedByUser    UserActor?          @relation("ConfirmedByUser", fields: [tenantId, confirmedByUserId], references: [tenantId, id])

  // IDEMPOTENCY: satu proses pencocokan per (tenant, versi dokumen, field ekstraksi, jenis entitas)
  @@unique([tenantId, documentVersionId, extractionResultId, entityType])
  @@unique([tenantId, id])
  @@index([tenantId, documentId])
  @@index([tenantId, documentVersionId])
  @@index([tenantId, status])
  @@index([tenantId, manuallyConfirmed])
  @@map("matching_results")
}

// P0-J: Satu atau lebih kandidat untuk satu MatchingResult
// Setiap kandidat adalah entitas Siswa atau Guru & Karyawan yang berpotensi cocok
model MatchingCandidate {
  id               String   @id @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  matchingResultId String   @map("matching_result_id") @db.Uuid
  // ID entitas yang ditemukan (Student.id atau Employee.id)
  matchedEntityId  String   @map("matched_entity_id") @db.Uuid
  // "STUDENT" atau "EMPLOYEE"
  entityType       String   @db.VarChar(50)
  // Field yang dipakai untuk mencocokkan (e.g. "nisn", "nik", "nip", "fullName")
  matchedField     String   @map("matched_field") @db.VarChar(100)
  candidateScore   Decimal? @db.Decimal(5, 2)
  candidateReason  String?  @db.Text
  // Urutan ranking kandidat (1 = tertinggi)
  ranking          Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  matchingResult     MatchingResult  @relation("ResultCandidates", fields: [tenantId, matchingResultId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)
  confirmedInResults MatchingResult[] @relation("ConfirmedCandidate")

  // IDEMPOTENCY: satu kandidat per entitas per hasil matching
  @@unique([tenantId, matchingResultId, matchedEntityId])
  @@unique([tenantId, id])
  @@index([tenantId, matchingResultId])
  @@index([tenantId, matchedEntityId])
  @@map("matching_candidates")
}

model HumanVerification {
  id               String               @id @db.Uuid
  tenantId         String               @map("tenant_id") @db.Uuid
  targetEntityType String               @map("target_entity_type") @db.VarChar(50)
  targetEntityId   String               @map("target_entity_id") @db.Uuid
  verifiedByUserId String               @map("verified_by_user_id") @db.Uuid
  decision         VerificationDecision @map("decision")
  notes            String?              @db.Text
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz

  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  verifiedByUser UserActor @relation(fields: [tenantId, verifiedByUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, targetEntityType, targetEntityId])
  @@map("human_verifications")
}

model WorkflowInstance {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  entityType     String    @map("entity_type") @db.VarChar(50)
  entityId       String    @map("entity_id") @db.Uuid
  currentState   String    @map("current_state") @db.VarChar(50)
  version        Int       @default(0) @map("version")
  lockedByUserId String?   @map("locked_by_user_id") @db.Uuid
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lockedByUser   UserActor?           @relation(fields: [tenantId, lockedByUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  transitions    WorkflowTransition[]
  exceptionItems ExceptionItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, entityType, entityId])
  @@index([tenantId, currentState])
  @@map("workflow_instances")
}

model WorkflowTransition {
  id                 String   @id @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  workflowInstanceId String   @map("workflow_instance_id") @db.Uuid
  event              String   @map("event") @db.VarChar(50)
  expectedVersion    Int      @map("expected_version")
  fromState          String   @map("from_state") @db.VarChar(50)
  toState            String   @map("to_state") @db.VarChar(50)
  idempotencyKey     String   @map("idempotency_key") @db.VarChar(255)
  correlationId      String?  @map("correlation_id") @db.VarChar(255)
  triggeredByUserId  String   @map("triggered_by_user_id") @db.Uuid
  reason             String?  @db.Text
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  workflowInstance WorkflowInstance @relation(fields: [tenantId, workflowInstanceId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)
  triggeredByUser  UserActor        @relation(fields: [tenantId, triggeredByUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, workflowInstanceId, idempotencyKey])
  @@map("workflow_transitions")
}

model ValidationResult {
  id               String   @id @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  ruleCode         String   @map("rule_code") @db.VarChar(100)
  targetEntityType String   @map("target_entity_type") @db.VarChar(50)
  targetEntityId   String   @map("target_entity_id") @db.Uuid
  passed           Boolean  @map("passed")
  detailsJson      Json?    @map("details_json")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, targetEntityType, targetEntityId])
  @@map("validation_results")
}

model ExceptionItem {
  id                 String          @id @db.Uuid
  tenantId           String          @map("tenant_id") @db.Uuid
  workflowInstanceId String          @map("workflow_instance_id") @db.Uuid
  ruleCode           String          @map("rule_code") @db.VarChar(100)
  severity           Severity
  status             ExceptionStatus @default(OPEN)
  assignedToUserId   String?         @map("assigned_to_user_id") @db.Uuid
  resolutionNotes    String?         @map("resolution_notes") @db.Text
  resolvedByUserId   String?         @map("resolved_by_user_id") @db.Uuid
  resolvedAt         DateTime?       @map("resolved_at") @db.Timestamptz
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  workflowInstance WorkflowInstance @relation(fields: [tenantId, workflowInstanceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  assignedToUser   UserActor?       @relation("AssignedExceptions", fields: [tenantId, assignedToUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  resolvedByUser   UserActor?       @relation("ResolvedExceptions", fields: [tenantId, resolvedByUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, severity])
  @@map("exception_items")
}

model AuditEvent {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(50)
  entityId    String   @map("entity_id") @db.Uuid
  payloadJson Json?    @map("payload_json")
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actorUser UserActor? @relation(fields: [tenantId, actorUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
  @@map("audit_events")
}

model PublicUploadInvitation {
  id                String                       @id @db.Uuid
  tenantId          String                       @map("tenant_id") @db.Uuid
  tokenHash         String                       @unique @map("token_hash") @db.VarChar(64)
  recipientEmail    String                       @map("recipient_email") @db.VarChar(255)
  recipientName     String?                      @map("recipient_name") @db.VarChar(255)
  documentCategory  DocumentCategory             @map("document_category")
  targetEntityType  String                       @map("target_entity_type") @db.VarChar(50)
  targetEntityId    String                       @map("target_entity_id") @db.Uuid
  status            PublicUploadInvitationStatus @default(PENDING)
  documentId        String?                      @map("document_id") @db.Uuid
  createdByUserId   String                       @map("created_by_user_id") @db.Uuid
  expiresAt         DateTime                     @map("expires_at") @db.Timestamptz
  consumedAt        DateTime?                    @map("consumed_at") @db.Timestamptz
  maxUploadAttempts Int                          @default(3) @map("max_upload_attempts")
  uploadAttempts    Int                          @default(0) @map("upload_attempts")
  createdAt         DateTime                     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdByUser UserActor @relation("CreatedPublicInvitations", fields: [tenantId, createdByUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  document      Document? @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, targetEntityType, targetEntityId])
  @@index([tokenHash])
  @@map("public_upload_invitations")
}

model DocumentProcessingJob {
  id                String                   @id @db.Uuid
  tenantId          String                   @map("tenant_id") @db.Uuid
  documentId        String                   @map("document_id") @db.Uuid
  documentVersionId String                   @map("document_version_id") @db.Uuid
  actorId           String                   @map("actor_id") @db.Uuid
  targetDomain      String                   @map("target_domain") @db.VarChar(50)
  metadata          Json?                    @map("metadata")
  status            DocumentProcessingStatus @default(QUEUED)
  attempts          Int                      @default(0) @map("attempts")
  maxAttempts       Int                      @default(3) @map("max_attempts")
  lastError         String?                  @map("last_error") @db.Text
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  processedAt       DateTime?                @map("processed_at") @db.Timestamptz

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  document        Document        @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  documentVersion DocumentVersion @relation(fields: [tenantId, documentVersionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  actor           UserActor       @relation(fields: [tenantId, actorId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, documentVersionId])
  @@index([tenantId, status])
  @@index([status, createdAt])
  @@map("document_processing_jobs")
}
