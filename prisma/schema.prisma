// Prisma Schema Specification for Banyubiru Administrative Intelligence Platform
// Phase 4G Canonical Schema Reconciliation - Authoritative Tenant-Aware Model

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------
// ENUM DEFINITIONS
// ----------------------------------------------------

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserRole {
  ADMIN
  VERIFIKATOR
  PEGAWAI
  OPERATOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum EmployeeStatus {
  PNS
  PPPK
  HONORER
  NON_ASN
}

enum AwardType {
  MASA_KERJA
  SATYALANCANA
}

enum ProposalStatus {
  NOMINATIF
  BELUM_UPLOAD
  SEBAGIAN
  LENGKAP
  DIVERIFIKASI
  SIAP_GENERATE
  GENERATED
  DITANDATANGANI
  DIKIRIM
  SELESAI
}

enum ChecklistStatus {
  BELUM_LENGKAP
  LENGKAP
  SIAP_GENERATE
}

enum DocumentCategory {
  SK_CPNS
  SK_PNS
  SK_JABATAN
  SKP_2_TAHUN
  SURAT_PENGANTAR
  DP3
  SERTIFIKAT
  FOTO
  IDENTITAS
  LAINNYA
}

enum DocumentStatus {
  DRAFT
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  ARCHIVED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  NEEDS_CORRECTION
}

enum VerificationDecision {
  VERIFIED
  REJECTED
  CORRECTED
}

enum StudentStatus {
  ACTIVE
  GRADUATED
  TRANSFERRED
}

enum AbsenceStatus {
  Sakit
  Izin
  Alpha
}

enum OCRExtractionStatus {
  NEEDS_VERIFICATION
  IN_PROGRESS
  VERIFIED
  COMPLETED
}

enum StudentAbsenceWorkflowState {
  DRAFT
  NEEDS_VERIFICATION
  REQUIRES_CORRECTION
  VERIFIED
  COMPLETED
}

enum Severity {
  INFO
  WARNING
  ERROR
}

enum ExceptionStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

// ----------------------------------------------------
// MODEL DEFINITIONS
// ----------------------------------------------------

model Tenant {
  id        String       @id @db.Uuid
  name      String       @db.VarChar(255)
  code      String       @unique @db.VarChar(64)
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  users                  UserActor[]
  employees              Employee[]
  awardProposals         AwardProposal[]
  students               Student[]
  absenceRecords         AbsenceRecord[]
  documents              Document[]
  ocrExtractions         OCRExtraction[]
  humanVerifications     HumanVerification[]
  workflowInstances      WorkflowInstance[]
  validationResults      ValidationResult[]
  exceptionItems         ExceptionItem[]
  auditEvents            AuditEvent[]
  extractedItems         ExtractedItem[]
  documentVersions       DocumentVersion[]
  workflowTransitions    WorkflowTransition[]
  awardProposalDocuments AwardProposalDocument[]

  @@map("tenants")
}

model UserActor {
  id        String     @id @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  username  String     @db.VarChar(128)
  email     String     @db.VarChar(255)
  fullName  String     @map("full_name") @db.VarChar(255)
  role      UserRole
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant                    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  verifiedProposalDocuments AwardProposalDocument[]
  humanVerifications        HumanVerification[]
  lockedWorkflowInstances   WorkflowInstance[]
  workflowTransitions       WorkflowTransition[]
  assignedExceptions        ExceptionItem[]         @relation("AssignedExceptions")
  resolvedExceptions        ExceptionItem[]         @relation("ResolvedExceptions")
  auditEvents               AuditEvent[]

  @@unique([tenantId, id])
  @@unique([tenantId, username])
  @@unique([tenantId, email])
  @@index([tenantId, role])
  @@map("user_actors")
}

model Employee {
  id                String         @id @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  nip               String         @db.VarChar(18)
  nrk               String         @db.VarChar(10)
  fullName          String         @map("nama_lengkap") @db.VarChar(255)
  gelarDepan        String?        @map("gelar_depan") @db.VarChar(50)
  gelarBelakang     String?        @map("gelar_belakang") @db.VarChar(50)
  jabatan           String         @db.VarChar(255)
  unitKerja         String         @map("unit_kerja") @db.VarChar(255)
  instansi          String         @map("instansi") @db.VarChar(255)
  statusKepegawaian EmployeeStatus @map("status_kepegawaian")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  awardProposals AwardProposal[]

  @@unique([tenantId, id])
  @@unique([tenantId, nip])
  @@unique([tenantId, nrk])
  @@index([tenantId, unitKerja])
  @@map("employees")
}

model AwardProposal {
  id               String                  @id @db.Uuid
  tenantId         String                  @map("tenant_id") @db.Uuid
  employeeId       String                  @map("employee_id") @db.Uuid
  jenisPenghargaan AwardType               @map("jenis_penghargaan")
  tahunUsulan      Int                     @map("tahun_usulan")
  masaKerjaTahun   Int                     @default(0) @map("masa_kerja_tahun")
  masaKerjaBulan   Int                     @default(0) @map("masa_kerja_bulan")
  status           ProposalStatus          @default(NOMINATIF)
  catatan          String?                 @db.Text
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  employee  Employee                @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  documents AwardProposalDocument[]

  @@unique([tenantId, id])
  @@unique([tenantId, employeeId, jenisPenghargaan, tahunUsulan])
  @@index([tenantId, status])
  @@index([tenantId, jenisPenghargaan])
  @@map("award_proposals")
}

model AwardProposalDocument {
  id               String          @id @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  proposalId       String          @map("proposal_id") @db.Uuid
  documentId       String?         @map("document_id") @db.Uuid
  requirementCode  String          @map("requirement_code") @db.VarChar(100)
  status           ChecklistStatus @default(BELUM_LENGKAP)
  verifiedByUserId String?         @map("verified_by_user_id") @db.Uuid
  verifiedAt       DateTime?       @map("verified_at") @db.Timestamptz
  catatan          String?         @db.Text
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  proposal       AwardProposal @relation(fields: [tenantId, proposalId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)
  document       Document?     @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  verifiedByUser UserActor?    @relation(fields: [tenantId, verifiedByUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@unique([proposalId, requirementCode])
  @@index([tenantId, status])
  @@map("award_proposal_documents")
}

model Student {
  id        String        @id @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  nisn      String        @db.VarChar(10)
  nis       String        @db.VarChar(20)
  fullName  String        @map("nama_lengkap") @db.VarChar(255)
  className String        @map("kelas") @db.VarChar(50)
  jurusan   String?       @map("jurusan") @db.VarChar(100)
  status    StudentStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  absenceRecords AbsenceRecord[]
  extractedItems ExtractedItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, nisn])
  @@unique([tenantId, nis])
  @@index([tenantId, className])
  @@map("students")
}

model AbsenceRecord {
  id          String        @id @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  studentId   String        @map("student_id") @db.Uuid
  absenceDate DateTime      @map("absence_date") @db.Date
  status      AbsenceStatus
  reason      String?       @db.Text
  documentId  String?       @map("document_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  student       Student        @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  document      Document?      @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  extractedItem ExtractedItem?

  @@unique([tenantId, id])
  @@unique([tenantId, studentId, absenceDate])
  @@index([tenantId, absenceDate])
  @@map("absence_records")
}

model OCRExtraction {
  id           String              @id @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  documentId   String              @map("document_id") @db.Uuid
  status       OCRExtractionStatus @default(NEEDS_VERIFICATION)
  rawJson      Json?               @map("raw_json")
  errorMessage String?             @map("error_message") @db.Text
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  document Document        @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  items    ExtractedItem[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("ocr_extractions")
}

model ExtractedItem {
  id               String   @id @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  ocrExtractionId  String   @map("ocr_extraction_id") @db.Uuid
  studentNameRaw   String   @map("student_name_raw") @db.VarChar(255)
  nisnRaw          String?  @map("nisn_raw") @db.VarChar(20)
  absenceDateRaw   String?  @map("absence_date_raw") @db.VarChar(50)
  absenceTypeRaw   String?  @map("absence_type_raw") @db.VarChar(50)
  confidenceScore  Decimal  @map("confidence_score") @db.Decimal(5, 2)
  matchedStudentId String?  @map("matched_student_id") @db.Uuid
  absenceRecordId  String?  @map("absence_record_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ocrExtraction  OCRExtraction  @relation(fields: [tenantId, ocrExtractionId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)
  matchedStudent Student?       @relation(fields: [tenantId, matchedStudentId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  absenceRecord  AbsenceRecord? @relation(fields: [tenantId, absenceRecordId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, absenceRecordId])
  @@index([ocrExtractionId])
  @@map("extracted_items")
}

model Document {
  id             String           @id @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  title          String           @db.VarChar(255)
  category       DocumentCategory
  currentVersion Int              @default(1) @map("current_version")
  status         DocumentStatus   @default(DRAFT)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  versions               DocumentVersion[]
  awardProposalDocuments AwardProposalDocument[]
  absenceRecords         AbsenceRecord[]
  ocrExtractions         OCRExtraction[]

  @@unique([tenantId, id])
  @@index([tenantId, category])
  @@map("documents")
}

model DocumentVersion {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  documentId     String   @map("document_id") @db.Uuid
  versionNumber  Int      @map("version_number")
  filePath       String   @map("file_path") @db.VarChar(500)
  fileSizeBytes  BigInt   @map("file_size_bytes")
  mimeType       String   @map("mime_type") @db.VarChar(100)
  checksumSha256 String   @map("checksum_sha256") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  document Document @relation(fields: [tenantId, documentId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@unique([documentId, versionNumber])
  @@map("document_versions")
}

model HumanVerification {
  id               String               @id @db.Uuid
  tenantId         String               @map("tenant_id") @db.Uuid
  targetEntityType String               @map("target_entity_type") @db.VarChar(50)
  targetEntityId   String               @map("target_entity_id") @db.Uuid
  verifiedByUserId String               @map("verified_by_user_id") @db.Uuid
  decision         VerificationDecision @map("decision")
  notes            String?              @db.Text
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  verifiedByUser UserActor @relation(fields: [tenantId, verifiedByUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, targetEntityType, targetEntityId])
  @@map("human_verifications")
}

model WorkflowInstance {
  id             String                      @id @db.Uuid
  tenantId       String                      @map("tenant_id") @db.Uuid
  entityType     String                      @map("entity_type") @db.VarChar(50)
  entityId       String                      @map("entity_id") @db.Uuid
  currentState   StudentAbsenceWorkflowState @map("current_state")
  lockedByUserId String?                     @map("locked_by_user_id") @db.Uuid
  lockedUntil    DateTime?                   @map("locked_until") @db.Timestamptz
  createdAt      DateTime                    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lockedByUser   UserActor?           @relation(fields: [tenantId, lockedByUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  transitions    WorkflowTransition[]
  exceptionItems ExceptionItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, entityType, entityId])
  @@index([tenantId, currentState])
  @@map("workflow_instances")
}

model WorkflowTransition {
  id                 String                      @id @db.Uuid
  tenantId           String                      @map("tenant_id") @db.Uuid
  workflowInstanceId String                      @map("workflow_instance_id") @db.Uuid
  fromState          StudentAbsenceWorkflowState @map("from_state")
  toState            StudentAbsenceWorkflowState @map("to_state")
  triggeredByUserId  String                      @map("triggered_by_user_id") @db.Uuid
  reason             String?                     @db.Text
  createdAt          DateTime                    @default(now()) @map("created_at") @db.Timestamptz

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  workflowInstance WorkflowInstance @relation(fields: [tenantId, workflowInstanceId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)
  triggeredByUser  UserActor        @relation(fields: [tenantId, triggeredByUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@map("workflow_transitions")
}

model ValidationResult {
  id               String   @id @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  ruleCode         String   @map("rule_code") @db.VarChar(100)
  targetEntityType String   @map("target_entity_type") @db.VarChar(50)
  targetEntityId   String   @map("target_entity_id") @db.Uuid
  passed           Boolean  @map("passed")
  detailsJson      Json?    @map("details_json")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, targetEntityType, targetEntityId])
  @@map("validation_results")
}

model ExceptionItem {
  id                 String          @id @db.Uuid
  tenantId           String          @map("tenant_id") @db.Uuid
  workflowInstanceId String          @map("workflow_instance_id") @db.Uuid
  ruleCode           String          @map("rule_code") @db.VarChar(100)
  severity           Severity
  status             ExceptionStatus @default(OPEN)
  assignedToUserId   String?         @map("assigned_to_user_id") @db.Uuid
  resolutionNotes    String?         @map("resolution_notes") @db.Text
  resolvedByUserId   String?         @map("resolved_by_user_id") @db.Uuid
  resolvedAt         DateTime?       @map("resolved_at") @db.Timestamptz
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  workflowInstance WorkflowInstance @relation(fields: [tenantId, workflowInstanceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  assignedToUser   UserActor?       @relation("AssignedExceptions", fields: [tenantId, assignedToUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  resolvedByUser   UserActor?       @relation("ResolvedExceptions", fields: [tenantId, resolvedByUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, severity])
  @@map("exception_items")
}

model AuditEvent {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(50)
  entityId    String   @map("entity_id") @db.Uuid
  payloadJson Json?    @map("payload_json")
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actorUser UserActor? @relation(fields: [tenantId, actorUserId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
  @@map("audit_events")
}
